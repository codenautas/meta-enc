{
  "name": "meta-enc",
  "description": "Metadatos de encuestas",
  "version": "1.4.19",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": "codenautas/meta-enc",
  "main": "dist/server/app-meta-enc.js",
  "types": "dist/server/app-meta-enc.d.ts",
  "files": [
    "dist",
    "install",
    "unlogged"
  ],
  "dependencies": {
    "rel-enc": "^1.3.20"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "mixin-patch": "^0.4.0",
    "mocha": "^11.8.0",
    "types.d.ts": "^0.6.7",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 14.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "(tsc -p src/client || echo \"continue w/error\") & (tsc -p src/server || echo \"continue w/error\") && mixin-patch",
    "test": "tsc -p src/tests && mocha --reporter spec --bail --check-leaks compile-for-test/tests/*.js",
    "start": "node dist/server/server-meta-enc.js"
  },
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "app",
    "ecmaVersion": 6
  }
}
